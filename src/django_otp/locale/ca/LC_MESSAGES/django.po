#: src/django_otp/forms.py:63
msgid "Please enter your OTP token."
msgstr "Si us plau, introduïu el vostre token OTP."

#: src/django_otp/forms.py:64
#, python-brace-format
msgid "Error generating challenge: {0}"
msgstr "Error en generar el repte: {0}"

#: src/django_otp/forms.py:65
msgid "The selected OTP device is not interactive"
msgstr "El dispositiu OTP seleccionat no és interactiu"

#: src/django_otp/forms.py:66
#, python-brace-format
msgid "OTP Challenge: {0}"
msgstr "Repte OTP: {0}"

#: src/django_otp/forms.py:68
msgid "Invalid token. Please make sure you have entered it correctly."
msgstr "Token no vàlid. Assegureu-vos que l'heu introduït correctament."

#: src/django_otp/forms.py:71
#, python-format
msgid ""
"Verification temporarily disabled because of %(failure_count)d failed "
"attempt, please try again soon."
msgid_plural ""
"Verification temporarily disabled because of %(failure_count)d failed "
"attempts, please try again soon."
msgstr[0] ""
"Verificació temporalment desactivada a causa de %(failure_count)d intent fallit. Torneu-ho a intentar aviat."
msgstr[1] ""
"Verificació temporalment desactivada a causa de %(failure_count)d intents fallits. Torneu-ho a intentar aviat."

#: src/django_otp/forms.py:76
msgid "Verification of the token is currently disabled"
msgstr "La verificació del token està actualment desactivada"

#: src/django_otp/plugins/otp_email/models.py:75
#, python-format
msgid ""
"Token generation cooldown period has not expired yet. Next generation "
"allowed %s."
msgstr ""
"El període de temps de reinici de la generació de tokens encara no ha expirat. Es permet la"
"generació següent %s."

#: src/django_otp/plugins/otp_email/models.py:81
msgid "Token generation is not allowed at this time"
msgstr "La generació de tokens no està permesa en aquest moment."

#: src/django_otp/plugins/otp_email/models.py:109
msgid "sent by email"
msgstr "enviat per email"

#: src/django_otp/templates/otp/admin111/login.html:38
msgid "Please correct the errors below."
msgstr "Si us plau, corregiu els següents errors."

#: src/django_otp/templates/otp/admin111/login.html:54
#, python-format
msgid ""
"You are authenticated as %(username)s, but are not authorized to access this "
"page. Would you like to login to a different account?"
msgstr ""
"Estàs autenticat com a %(username)s, però no esteu autoritzat a accedir a aquesta "
"pàgina. Voleu iniciar la sessió amb un compte diferent?"

#: src/django_otp/templates/otp/admin111/login.html:74
msgid "OTP Device:"
msgstr "Dispositiu OTP:"

#: src/django_otp/templates/otp/admin111/login.html:79
msgid "OTP Token:"
msgstr "Token OTP:"

#: src/django_otp/templates/otp/admin111/login.html:84
msgid "Forgotten your password or username?"
msgstr "Has oblidat la contrasenya o el nom d'usuari?"

#: src/django_otp/templates/otp/admin111/login.html:88
msgid "Log in"
msgstr "Inicia sessió"

#: src/django_otp/templates/otp/admin111/login.html:90
msgid "Get OTP Challenge"
msgstr "Obteniu el repte OTP"
